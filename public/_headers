# Cloudflare applies EVERY rule whose path matches and joins same-name headers
# with commas. Keep exactly one Cache-Control rule per served path, and never
# put Cache-Control in /* (it would be appended to every other rule).
#
# Paths are public addresses, so they include the game's prefix (base_path in
# wrangler.jsonc). Only the game's addresses reach this Worker, so /* is all of them.

# Vite content-hashes everything in bundle/, so those files never change in place.
/games/mimic-feeder/bundle/*
  Cache-Control: public, max-age=31536000, immutable

/games/mimic-feeder/assets/*
  # Unversioned media paths: revalidate within a day so deploys refresh sprites/SFX.
  Cache-Control: public, max-age=86400, must-revalidate

/games/mimic-feeder/
  Cache-Control: public, max-age=3600

/games/mimic-feeder/index.html
  Cache-Control: public, max-age=3600

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; object-src 'none'; img-src 'self' data:; style-src 'self'; connect-src 'self' https://cloudflareinsights.com
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
