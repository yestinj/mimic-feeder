{
  "name": "mimic-feeder",
  "version": "1.0.0-beta",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "lint": "node scripts/lint.js",
    "lint:p5-globals": "node scripts/generate-p5-globals.js",
    "typecheck": "tsc -p game/tsconfig.json",
    "test:unit": "vitest run --config game/vite.config.mts",
    "smoke": "node scripts/smoke.js",
    "playtest": "node scripts/playtest.js",
    "playtest:install": "playwright install --no-shell chromium",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run smoke",
    "check": "npm test && npm run playtest",
    "check:live": "node scripts/live-check.js",
    "start": "node scripts/serve.js",
    "dev": "node --watch-path=src build.js",
    "dev:next": "vite --config game/vite.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "phaser": "^4.2.1",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "description": "A fun little game where you control a dungeon mimic to collect food and shinies while avoiding bombs.",
  "main": "build.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yestinj/mimic-feeder.git"
  },
  "keywords": [],
  "author": "",
  "license": "CC-BY-NC-4.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yestinj/mimic-feeder/issues"
  },
  "homepage": "https://github.com/yestinj/mimic-feeder#readme"
}
