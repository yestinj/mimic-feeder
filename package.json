{
  "name": "mimic-feeder",
  "version": "1.0.0-beta",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "vite",
    "lint": "node scripts/lint.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "playtest": "node scripts/playtest.js",
    "playtest:install": "playwright install --no-shell chromium",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "check": "npm test && npm run playtest",
    "check:live": "node scripts/live-check.js",
    "start": "node scripts/serve.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "phaser": "^4.2.1",
    "playwright": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "description": "A fun little game where you control a dungeon mimic to collect food and shinies while avoiding bombs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yestinj/mimic-feeder.git"
  },
  "keywords": [],
  "author": "",
  "license": "CC-BY-NC-4.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yestinj/mimic-feeder/issues"
  },
  "homepage": "https://github.com/yestinj/mimic-feeder#readme"
}
