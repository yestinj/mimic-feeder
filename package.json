{
  "name": "mimic-feeder",
  "version": "1.0.0-beta",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "lint": "node scripts/lint.js",
    "lint:p5-globals": "node scripts/generate-p5-globals.js",
    "smoke": "node scripts/smoke.js",
    "playtest": "node scripts/playtest.js",
    "playtest:install": "playwright install --no-shell chromium",
    "test": "npm run lint && npm run build && npm run smoke",
    "check": "npm test && npm run playtest",
    "check:live": "node scripts/live-check.js",
    "start": "node scripts/serve.js",
    "dev": "node --watch-path=src build.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0"
  },
  "description": "A fun little game where you control a dungeon mimic to collect food and shinies while avoiding bombs.",
  "main": "build.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yestinj/mimic-feeder.git"
  },
  "keywords": [],
  "author": "",
  "license": "CC-BY-NC-4.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yestinj/mimic-feeder/issues"
  },
  "homepage": "https://github.com/yestinj/mimic-feeder#readme"
}
